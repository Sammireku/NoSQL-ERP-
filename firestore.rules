rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Pillar 1) - Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================
    
    // Check if user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Verify if the user belongs to the organization
    function isTenant(orgId) {
      return isAuthenticated() && request.auth.token.orgId == orgId;
    }
    
    // Fetch the user's role directly from their Custom Claims token
    function getUserRole() {
      return request.auth.token.role;
    }
    
    // Check for specific roles within the organization tenant (CEO has full privileges)
    function isCEO(orgId) {
      return isTenant(orgId) && (getUserRole() == 'ceo' || getUserRole() == 'sysadmin');
    }

    function isManager(orgId) {
      return isTenant(orgId) && (getUserRole() == 'manager' || getUserRole() == 'ceo' || getUserRole() == 'sysadmin');
    }
    
    function isSales(orgId) {
      return isTenant(orgId) && (getUserRole() == 'sales' || getUserRole() == 'ceo' || getUserRole() == 'sysadmin');
    }
    
    function isCashier(orgId) {
      return isTenant(orgId) && (getUserRole() == 'cashier' || getUserRole() == 'ceo' || getUserRole() == 'sysadmin');
    }

    function isWarehouse(orgId) {
      return isTenant(orgId) && (getUserRole() == 'warehouse' || getUserRole() == 'ceo' || getUserRole() == 'manager' || getUserRole() == 'sysadmin');
    }

    function isDriver(orgId) {
      return isTenant(orgId) && (getUserRole() == 'driver' || getUserRole() == 'ceo' || getUserRole() == 'manager');
    }

    // Validate if an ID is safe and within size boundaries to prevent value poisoning
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // ==========================================
    // TOP-LEVEL USERS COLLECTION
    // ==========================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || resource.data.uid == request.auth.uid);
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // ==========================================
    // TOP-LEVEL ORGANIZATIONS COLLECTION
    // ==========================================
    match /organizations/{orgId} {
      allow read, write: if isAuthenticated();

      // Subcollections under Organization
      match /opportunities/{opportunityId} {
        allow get, list: if isTenant(orgId) && isValidId(opportunityId);
        allow create: if (isManager(orgId) || isSales(orgId)) && isValidId(opportunityId);
        allow update: if (isManager(orgId) || (
          isSales(orgId) && 
          request.resource.data.kanban_stage != 'Closed' &&
          resource.data.kanban_stage != 'Closed'
        )) && isValidId(opportunityId);
        allow delete: if isManager(orgId) && isValidId(opportunityId);
      }

      match /pos_orders/{orderId} {
        allow get, list: if (isManager(orgId) || isCashier(orgId)) && isValidId(orderId);
        allow create: if (isManager(orgId) || isCashier(orgId)) && isValidId(orderId);
        allow update, delete: if isManager(orgId) && isValidId(orderId);
      }

      match /products/{productId} {
        allow get, list: if isTenant(orgId) && isValidId(productId);
        allow write: if isWarehouse(orgId) && isValidId(productId);
      }

      match /inventory_levels/{productId} {
        allow get, list: if isTenant(orgId) && isValidId(productId);
        allow write: if isWarehouse(orgId) && isValidId(productId);
      }

      match /users/{userId} {
        allow get: if isTenant(orgId) && (request.auth.uid == userId || isManager(orgId)) && isValidId(userId);
        allow list: if isTenant(orgId);
        allow write: if isManager(orgId) && isValidId(userId);
      }

      match /manuals/{manualId} {
        allow read: if isTenant(orgId) && isValidId(manualId);
        allow write: if isManager(orgId) && isValidId(manualId);
      }
    }

    // ==========================================
    // TOP-LEVEL AUDIT LOGS
    // ==========================================
    match /audit_logs/{logId} {
      allow read, create: if isAuthenticated() && isValidId(logId);
    }

    // ==========================================
    // FLEET & VEHICLE LOGISTICS COLLECTIONS
    // ==========================================
    match /vehicles/{vehicleId} {
      allow read: if isAuthenticated() && isValidId(vehicleId);
      allow write: if isAuthenticated() && isValidId(vehicleId);
    }

    match /vehicle_trips/{tripId} {
      allow read: if isAuthenticated() && isValidId(tripId);
      allow write: if isAuthenticated() && isValidId(tripId);
    }

    match /vehicle_maintenance/{maintenanceId} {
      allow read: if isAuthenticated() && isValidId(maintenanceId);
      allow write: if isAuthenticated() && isValidId(maintenanceId);
    }

    match /vehicle_expenses/{expenseId} {
      allow read: if isAuthenticated() && isValidId(expenseId);
      allow write: if isAuthenticated() && isValidId(expenseId);
    }

    match /vehicle_issues/{issueId} {
      allow read: if isAuthenticated() && isValidId(issueId);
      allow write: if isAuthenticated() && isValidId(issueId);
    }

    match /driver_licenses/{licenseId} {
      allow read: if isAuthenticated() && isValidId(licenseId);
      allow write: if isAuthenticated() && isValidId(licenseId);
    }
  }
}
